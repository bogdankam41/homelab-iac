# Managed by Ansible (roles/monitoring) — do not edit by hand.
# Devices are defined in envs/<env>/terraform.tfvars (monitoring_targets).
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
{% if prometheus_external_labels %}
  external_labels:
{% for key, value in prometheus_external_labels | dictsort %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:9093

scrape_configs:
  # The stack watching itself.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          name: prometheus

  - job_name: alertmanager
    static_configs:
      - targets: ["localhost:9093"]
        labels:
          name: alertmanager

  - job_name: grafana
    static_configs:
      - targets: ["localhost:{{ grafana_listen_port }}"]
        labels:
          name: grafana

  # Device jobs. Targets live in their own file_sd file, so adding a device to
  # an existing job is picked up by Prometheus without a reload.
{% for job in monitoring_jobs %}
  - job_name: {{ job }}
    file_sd_configs:
      - files:
          - /etc/prometheus/targets/{{ job }}.json
{% endfor %}

  # Blackbox probes, one job per probe group (monitoring_probes[].job).
{% for job in monitoring_probes | map(attribute='job') | unique | sort %}
  - job_name: {{ job }}
    metrics_path: /probe
    static_configs:
{% for p in monitoring_probes | selectattr('job', 'equalto', job) %}
      - targets: ["{{ p.target }}"]
        labels:
          name: "{{ p.name }}"
          module: "{{ p.module }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ blackbox_listen_address }}
{% endfor %}

{% if monitoring_pve_nodes %}
  # Proxmox VE API through pve_exporter: the node plus every VM/CT on it, no
  # agent inside the guests. instance is the node name (not its IP) and the
  # job sets no `name` label of its own, so pve_guest_info keeps the guest's
  # `name` — the grafana.com "Proxmox via Prometheus" board relies on both.
  - job_name: pve
    metrics_path: /pve
    static_configs:
{% for n in monitoring_pve_nodes %}
      - targets: ["{{ n.address }}"]
        labels:
          instance: "{{ n.name }}"
          module: "{{ n.name }}"
{% for key, value in (n.get('labels') or {}) | dictsort %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - target_label: __address__
        replacement: {{ pve_exporter_listen_address }}
{% endif %}

{% if monitoring_snmp_targets %}
  # Switches over SNMP through snmp_exporter. __param_* labels become URL
  # parameters: the device's own community (auth) and the MIBs to walk (module).
  - job_name: snmp
    metrics_path: /snmp
    scrape_interval: {{ monitoring_switch_scrape_interval }}
    static_configs:
{% for t in monitoring_snmp_targets %}
      - targets: ["{{ t.address }}"]
        labels:
          name: "{{ t.name }}"
          __param_auth: "{{ t.name }}"
          __param_module: "{{ (t.get('modules') or ['system', 'if_mib']) | join(',') }}"
{% for key, value in (t.get('labels') or {}) | dictsort %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ snmp_exporter_listen_address }}
{% endif %}

{% if monitoring_sks_switches %}
  # SKS3200 switches (no SNMP) through sks_exporter and their web UI's JSON API.
  - job_name: sks
    scrape_interval: {{ monitoring_switch_scrape_interval }}
    static_configs:
{% for s in monitoring_sks_switches %}
      - targets: ["{{ s.address }}"]
        labels:
          name: "{{ s.name }}"
{% for key, value in (s.get('labels') or {}) | dictsort %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ sks_exporter_listen_address }}
{% endif %}

{% if monitoring_dvr_recorders %}
  # Video recorders (no SNMP) through dvrip_exporter and their DVRIP port.
  - job_name: dvr
    scrape_interval: {{ monitoring_dvr_scrape_interval }}
    static_configs:
{% for r in monitoring_dvr_recorders %}
      - targets: ["{{ r.address }}"]
        labels:
          name: "{{ r.name }}"
{% for key, value in (r.get('labels') or {}) | dictsort %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ dvrip_exporter_listen_address }}
{% endif %}

  # Federation: a selected set of series from another Prometheus. honor_labels
  # keeps the source's job/instance/namespace labels; the entry's labels (e.g.
  # cluster) are added on top, so the series do not mix with local ones.
{% for f in monitoring_federation %}
  - job_name: {{ f.job }}
    honor_labels: true
    metrics_path: /federate
    scrape_interval: {{ monitoring_federation_interval }}
    params:
      'match[]':
{% for m in (f.get('match') or monitoring_federation_match) %}
        - '{{ m }}'
{% endfor %}
    static_configs:
      - targets: ["{{ f.address }}"]
{% if f.get('labels') %}
        labels:
{% for key, value in f['labels'] | dictsort %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% endfor %}

  # Exporters reachable only over TLS + basic auth. The CA (self-signed cert)
  # and the password sit in files next to this config, not inline.
{% for t in monitoring_secure_targets %}
  - job_name: {{ t.job }}
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/secrets/{{ t.job }}.crt
    basic_auth:
      username: {{ t.username }}
      password_file: /etc/prometheus/secrets/{{ t.job }}.password
    static_configs:
      - targets: ["{{ t.address }}"]
        labels:
          name: "{{ t.name }}"
{% endfor %}
