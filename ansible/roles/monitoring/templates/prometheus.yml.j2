# Managed by Ansible (roles/monitoring) — do not edit by hand.
# Devices are defined in envs/<env>/terraform.tfvars (monitoring_targets).
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
{% if prometheus_external_labels %}
  external_labels:
{% for key, value in prometheus_external_labels | dictsort %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:9093

scrape_configs:
  # The stack watching itself.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          name: prometheus

  - job_name: alertmanager
    static_configs:
      - targets: ["localhost:9093"]
        labels:
          name: alertmanager

  - job_name: grafana
    static_configs:
      - targets: ["localhost:{{ grafana_listen_port }}"]
        labels:
          name: grafana

  # Device jobs. Targets live in their own file_sd file, so adding a device to
  # an existing job is picked up by Prometheus without a reload.
{% for job in monitoring_jobs %}
  - job_name: {{ job }}
    file_sd_configs:
      - files:
          - /etc/prometheus/targets/{{ job }}.json
{% endfor %}

  # Blackbox probes, one job per probe group (monitoring_probes[].job).
{% for job in monitoring_probes | map(attribute='job') | unique | sort %}
  - job_name: {{ job }}
    metrics_path: /probe
    static_configs:
{% for p in monitoring_probes | selectattr('job', 'equalto', job) %}
      - targets: ["{{ p.target }}"]
        labels:
          name: "{{ p.name }}"
          module: "{{ p.module }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ blackbox_listen_address }}
{% endfor %}

  # Exporters reachable only over TLS + basic auth. The CA (self-signed cert)
  # and the password sit in files next to this config, not inline.
{% for t in monitoring_secure_targets %}
  - job_name: {{ t.job }}
    scheme: https
    tls_config:
      ca_file: /etc/prometheus/secrets/{{ t.job }}.crt
    basic_auth:
      username: {{ t.username }}
      password_file: /etc/prometheus/secrets/{{ t.job }}.password
    static_configs:
      - targets: ["{{ t.address }}"]
        labels:
          name: "{{ t.name }}"
{% endfor %}
