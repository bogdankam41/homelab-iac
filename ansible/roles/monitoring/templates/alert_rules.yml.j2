# Managed by Ansible (roles/monitoring) — do not edit by hand.
# Thresholds are variables (alert_* in roles/monitoring/defaults/main.yml),
# overridable from terraform.tfvars.
{% if not monitoring_alerts_enabled %}
groups: []
{% else %}
groups:
  - name: homelab.availability
    rules:
      - alert: InstanceDown
        expr: up == 0
        for: {{ alert_instance_down_for }}
        labels:
          severity: critical
        annotations:{% raw %}
          summary: '{{ or $labels.name $labels.instance }} is down'
          description: 'Prometheus cannot scrape {{ $labels.instance }} (job {{ $labels.job }}).'{% endraw %}

  - name: homelab.resources
    rules:
      - alert: HighCpuUsage
        expr: 100 - (avg by (instance, name, job) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > {{ alert_cpu_threshold }}
        for: {{ alert_cpu_for }}
        labels:
          severity: warning
          threshold: "{{ alert_cpu_threshold }}"
        annotations:{% raw %}
          summary: 'High CPU on {{ $labels.name }}'
          description: 'CPU usage is {{ printf "%.0f" $value }}% on {{ $labels.instance }}.'{% endraw %}

      - alert: HighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > {{ alert_memory_threshold }}
        for: {{ alert_memory_for }}
        labels:
          severity: warning
          threshold: "{{ alert_memory_threshold }}"
        annotations:{% raw %}
          summary: 'High memory usage on {{ $labels.name }}'
          description: 'Memory usage is {{ printf "%.0f" $value }}% on {{ $labels.instance }}.'{% endraw %}

      - alert: LowDiskSpace
        expr: (1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|squashfs|overlay|ramfs"} / node_filesystem_size_bytes{fstype!~"tmpfs|squashfs|overlay|ramfs"})) * 100 > {{ alert_disk_threshold }}
        for: {{ alert_disk_for }}
        labels:
          severity: warning
          threshold: "{{ alert_disk_threshold }}"
        annotations:{% raw %}
          summary: 'Low disk space on {{ $labels.name }}'
          description: '{{ $labels.mountpoint }} is {{ printf "%.0f" $value }}% full on {{ $labels.instance }}.'{% endraw %}

  - name: homelab.temperature
    rules:
      # hwmon exposes every chip the kernel knows about; alert_temp_chips keeps
      # the rule on CPU and disk sensors only (see roles/monitoring/defaults).
      # Devices without hwmon (Keenetic routers) only have the SoC thermal zone;
      # its type/zone are relabelled to chip/sensor so the annotation reads the same.
      - alert: HighTemperature
        expr: |
          (
            max by (instance, name, job, chip, sensor) (node_hwmon_temp_celsius{chip=~"{{ alert_temp_chips }}"})
            or max by (instance, name, job, chip, sensor) (
              label_replace(label_replace(node_thermal_zone_temp unless on (instance) node_hwmon_temp_celsius,
                "chip", "$1", "type", "(.+)"), "sensor", "zone$1", "zone", "(.+)"))
          ) > {{ alert_temp_threshold }}
        for: {{ alert_temp_for }}
        labels:
          severity: warning
          threshold: "{{ alert_temp_threshold }}"
        annotations:{% raw %}
          summary: 'High temperature on {{ $labels.name }}'
          description: '{{ $labels.chip }}/{{ $labels.sensor }} is {{ printf "%.0f" $value }}°C on {{ $labels.instance }}.'{% endraw %}
{% if monitoring_pve_nodes %}

  # pve_exporter (job pve). instance = Proxmox node, name = guest name.
  - name: homelab.proxmox
    rules:
      # Only guests that start on boot: a VM stopped on purpose is not an incident.
      - alert: GuestDown
        expr: |
          ((pve_up{id=~"(qemu|lxc)/.+"} == 0) and on (instance, id) (pve_onboot_status == 1))
            * on (instance, id) group_left (name, type) pve_guest_info
        for: {{ alert_instance_down_for }}
        labels:
          severity: critical
        annotations:{% raw %}
          summary: '{{ $labels.name }} is stopped on {{ $labels.instance }}'
          description: 'Proxmox reports {{ $labels.type }} {{ $labels.id }} not running, although it is set to start on boot.'{% endraw %}

      # Storage pools (local-lvm thin pool included), which node_exporter's
      # filesystem metrics do not see.
      - alert: PveStorageFull
        expr: pve_disk_usage_bytes{id=~"storage/.+"} / pve_disk_size_bytes{id=~"storage/.+"} * 100 > {{ alert_disk_threshold }}
        for: {{ alert_disk_for }}
        labels:
          severity: warning
          threshold: "{{ alert_disk_threshold }}"
        annotations:{% raw %}
          summary: 'Storage {{ $labels.id }} is filling up'
          description: '{{ $labels.id }} is {{ printf "%.0f" $value }}% full on {{ $labels.instance }}.'{% endraw %}

{% endif %}
{% if monitoring_snmp_targets or monitoring_sks_switches %}

  # Switches: job snmp (IF-MIB, ifName = port) and job sks (port = port number).
  # A switch that stops answering is already InstanceDown (up == 0).
  - name: homelab.switches
    rules:
      # A port that keeps going up and down: bad cable/transceiver or a looping device.
      - alert: SwitchPortFlapping
        expr: |
          label_replace(changes(ifOperStatus{job="snmp"}[15m]), "port", "$1", "ifName", "(.+)") > {{ alert_switch_flaps }}
            or changes(sks_port_up{job="sks"}[15m]) > {{ alert_switch_flaps }}
        labels:
          severity: warning
        annotations:{% raw %}
          summary: 'Port {{ $labels.port }} on {{ $labels.name }} is flapping'
          description: 'The link changed state {{ printf "%.0f" $value }} times in 15 minutes.'{% endraw %}

      - alert: SwitchPortErrors
        expr: |
          label_replace(increase(ifInErrors{job="snmp"}[15m]) + increase(ifOutErrors{job="snmp"}[15m]), "port", "$1", "ifName", "(.+)") > {{ alert_switch_errors }}
            or increase(sks_port_rx_errors_total{job="sks"}[15m]) + increase(sks_port_tx_errors_total{job="sks"}[15m]) > {{ alert_switch_errors }}
        labels:
          severity: warning
          threshold: "{{ alert_switch_errors }}"
        annotations:{% raw %}
          summary: 'Errors on port {{ $labels.port }} of {{ $labels.name }}'
          description: '{{ printf "%.0f" $value }} bad packets in 15 minutes - check the cable or transceiver.'{% endraw %}

      - alert: SwitchHighCpu
        expr: switchCpuBusy5m > {{ alert_cpu_threshold }}
        for: {{ alert_cpu_for }}
        labels:
          severity: warning
          threshold: "{{ alert_cpu_threshold }}"
        annotations:{% raw %}
          summary: 'High CPU on {{ $labels.name }}'
          description: 'Switch CPU is {{ printf "%.0f" $value }}% busy over 5 minutes.'{% endraw %}

      - alert: SwitchHighTemperature
        expr: sks_temperature_celsius > {{ alert_switch_temp_threshold }}
        for: {{ alert_temp_for }}
        labels:
          severity: warning
          threshold: "{{ alert_switch_temp_threshold }}"
        annotations:{% raw %}
          summary: 'High temperature on {{ $labels.name }}'
          description: 'Switch board is at {{ printf "%.0f" $value }}°C.'{% endraw %}
{% endif %}
{% if monitoring_dvr_recorders %}

  # Video recorders: job dvr (dvrip_exporter), channel/title = camera.
  # A recorder that stops answering is already InstanceDown (up == 0).
  - name: homelab.dvr
    rules:
      # IP cameras: the recorder lost the stream (camera power/PoE, cable, IP).
      - alert: CameraOffline
        expr: dvr_channel_connected == 0 or dvr_channel_video_loss == 1
        for: 5m
        labels:
          severity: critical
        annotations:{% raw %}
          summary: 'Camera {{ $labels.title }} is offline on {{ $labels.name }}'
          description: 'Channel {{ $labels.channel }} gets no video from the camera - check its power (PoE), cable and address.'{% endraw %}

      - alert: CameraNotRecording
        expr: dvr_channel_recording == 0 and on (instance, channel) dvr_channel_connected == 1
        for: 10m
        labels:
          severity: warning
        annotations:{% raw %}
          summary: 'Camera {{ $labels.title }} is not being recorded on {{ $labels.name }}'
          description: 'The camera is connected, but the recorder does not record channel {{ $labels.channel }} - check the record schedule.'{% endraw %}

      # Recorders like to stop writing silently: live view keeps working, the archive does not grow.
      - alert: DvrRecordingStalled
        expr: dvr_last_record_age_seconds > {{ alert_dvr_record_age }}
        for: 2m
        labels:
          severity: critical
          threshold: "{{ alert_dvr_record_age }}"
        annotations:{% raw %}
          summary: '{{ $labels.name }} has stopped recording'
          description: 'The newest video on disk is {{ humanizeDuration $value }} old.'{% endraw %}

      - alert: DvrDiskProblem
        expr: dvr_disks == 0 or dvr_disk_status != 0
        for: 5m
        labels:
          severity: critical
        annotations:{% raw %}
          summary: 'Disk problem on {{ $labels.name }}'
          description: '{{ if $labels.disk }}Disk {{ $labels.disk }} partition {{ $labels.partition }} reports status {{ $value }}{{ else }}The recorder sees no usable disk{{ end }}.'{% endraw %}

      # Expected for a week after a disk is replaced or formatted.
      - alert: DvrArchiveShort
        expr: dvr_archive_depth_seconds < {{ alert_dvr_archive_days }} * 86400
        for: 1h
        labels:
          severity: warning
          threshold: "{{ alert_dvr_archive_days }}"
        annotations:{% raw %}
          summary: 'Short video archive on {{ $labels.name }}'
          description: 'The disk holds only {{ humanizeDuration $value }} of video.'{% endraw %}
{% endif %}
{% endif %}
