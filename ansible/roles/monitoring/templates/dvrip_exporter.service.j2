# Managed by Ansible (roles/monitoring) — do not edit by hand.
[Unit]
Description=Prometheus exporter for XiongMai (DVRIP) video recorders
After=network-online.target
Wants=network-online.target

[Service]
User=prometheus
Group=prometheus
ExecStart=/usr/bin/python3 -I /usr/local/bin/dvrip_exporter \
  --config.file=/etc/dvrip_exporter/recorders.json \
  --web.listen-address={{ dvrip_exporter_listen_address }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
