{
  "uid": "homelab-overview",
  "title": "Homelab — обзор",
  "description": "Вся инфраструктура на одном экране: площадки, хосты, гости Proxmox, хранилища, алерты, WAN.",
  "tags": [
    "homelab",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Node Exporter Full",
      "type": "link",
      "url": "/d/rYdddlPWk/node-exporter-full",
      "keepTime": true
    },
    {
      "title": "Proxmox",
      "type": "link",
      "url": "/d/Dp7Cd57Zza/proxmox-via-prometheus",
      "keepTime": true
    },
    {
      "title": "Температура",
      "type": "link",
      "url": "/d/homelab-temperature",
      "keepTime": true
    },
    {
      "title": "k3s",
      "type": "link",
      "url": "/d/k3s-overview",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Площадка",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"node\"}, site)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "wan",
        "label": "WAN-интерфейс",
        "type": "constant",
        "hide": 2,
        "query": "eth3",
        "description": "WAN-интерфейс роутеров: у Keenetic — eth3. Регулярка, если роутеры разные."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Площадки",
      "description": "Есть ли хоть один отвечающий хост на площадке. Если pve-2 недоступна целиком — первым делом проверить IPSec-туннель.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (site) (up{job=~\"node|pve\", site=~\"$site\"})",
          "legendFormat": "{{site}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical",
        "text": {
          "valueSize": 32
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "в сети",
                  "color": "#0ca30c",
                  "index": 0
                },
                "0": {
                  "text": "недоступна",
                  "color": "#d03b3b",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Хосты в сети",
      "description": "Хосты с node_exporter, которые сейчас отвечают.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(up{job=\"node\", site=~\"$site\"} == 1)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Не отвечают",
      "description": "Цели node_exporter и pve_exporter, которые Prometheus не может опросить.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(up{job=~\"node|pve\", site=~\"$site\"} == 0) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
