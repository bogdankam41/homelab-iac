    {
      "type": "table",
      "title": "Активные алерты",
      "description": "То же, что в Alertmanager, без перехода туда. Пусто — значит, всё спокойно.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "alertname",
                "severity",
                "name",
                "site",
                "mountpoint",
                "instance"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "name": 2,
              "site": 3,
              "mountpoint": 4,
              "instance": 5
            },
            "renameByName": {
              "alertname": "Алерт",
              "severity": "Важность",
              "name": "Хост / гость",
              "site": "Площадка",
              "mountpoint": "Точка монтирования",
              "instance": "Цель"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Важность",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Активных алертов нет",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Важность"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "critical",
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "warning": {
                        "text": "warning",
                        "color": "#fab219",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "table",
      "title": "Хосты",
      "description": "Всё, где стоит node_exporter. Клик по имени — Node Exporter Full по этому хосту. Диск — самая заполненная файловая система хоста; t° — CPU/SoC, только у гипервизоров и роутеров (LXC видят датчики хоста).",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, name, site, role) (up{job=\"node\", site=~\"$site\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, name, site, role) (time() - node_boot_time_seconds{job=\"node\", site=~\"$site\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (1 - avg by (instance, name, site, role) (rate(node_cpu_seconds_total{job=\"node\", site=~\"$site\", mode=\"idle\"}[5m])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * max by (instance, name, site, role) (1 - node_memory_MemAvailable_bytes{job=\"node\", site=~\"$site\"} / node_memory_MemTotal_bytes{job=\"node\", site=~\"$site\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * max by (instance, name, site, role) (1 - node_filesystem_avail_bytes{job=\"node\", site=~\"$site\", fstype!~\"tmpfs|squashfs|overlay|ramfs\"} / node_filesystem_size_bytes{job=\"node\", site=~\"$site\", fstype!~\"tmpfs|squashfs|overlay|ramfs\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, name, site, role) (node_hwmon_temp_celsius{job=\"node\", site=~\"$site\", role=~\"hypervisor|router\", chip=~\".*coretemp.*|.*k10temp.*|.*cpu_thermal.*\"}) or max by (instance, name, site, role) (node_thermal_zone_temp{job=\"node\", site=~\"$site\", role=~\"hypervisor|router\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, name, site, role, nodename) (node_uname_info{job=\"node\", site=~\"$site\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #G": true
            },
            "indexByName": {
              "name": 0,
              "site": 1,
              "role": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #F": 8,
              "instance": 9,
              "nodename": 10
            },
            "renameByName": {
              "name": "Хост",
              "site": "Площадка",
              "role": "Роль",
              "Value #A": "Статус",
              "Value #B": "Uptime",
              "Value #C": "CPU",
              "Value #D": "RAM",
              "Value #E": "Диск",
              "Value #F": "t°"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Хост",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Хост"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Node Exporter Full: ${__data.fields.Хост}",
                    "url": "/d/rYdddlPWk/node-exporter-full?var-job=node&var-nodename=${__data.fields.nodename}&var-node=${__data.fields.instance}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Статус"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "0": {
                        "text": "DOWN",
                        "color": "#d03b3b",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#0ca30c",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 80
                    },
                    {
                      "color": "#d03b3b",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM"
