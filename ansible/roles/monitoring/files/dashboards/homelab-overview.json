    {
      "type": "table",
      "title": "Гости Proxmox",
      "description": "Все VM и CT обеих нод по API Proxmox (pve_exporter) — без агентов внутри. CPU — доля выделенных гостю ядер. RAM — как её видит Proxmox: у VM туда входит кэш гостя, поэтому шкала без статусных цветов, реальная загрузка — в таблице «Хосты». Клик по имени — дашборд Proxmox этой ноды.",
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, id, name, type, site) (pve_up{id=~\"(qemu|lxc)/.+\", site=~\"$site\"} * on (instance, id) group_left (name, type) pve_guest_info)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, id, name, type, site) (pve_onboot_status{id=~\"(qemu|lxc)/.+\", site=~\"$site\"} * on (instance, id) group_left (name, type) pve_guest_info)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, id, name, type, site) (100 * pve_cpu_usage_ratio{id=~\"(qemu|lxc)/.+\", site=~\"$site\"} * on (instance, id) group_left (name, type) pve_guest_info)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, id, name, type, site) (100 * pve_memory_usage_bytes{id=~\"(qemu|lxc)/.+\", site=~\"$site\"} / pve_memory_size_bytes{id=~\"(qemu|lxc)/.+\", site=~\"$site\"} * on (instance, id) group_left (name, type) pve_guest_info)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, id, name, type, site) (pve_uptime_seconds{id=~\"(qemu|lxc)/.+\", site=~\"$site\"} * on (instance, id) group_left (name, type) pve_guest_info)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
