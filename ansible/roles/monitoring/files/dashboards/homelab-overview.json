        "overrides": []
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Гости выкл.",
      "description": "VM/CT с автозапуском (onboot=1), которые сейчас не запущены. Выключенные намеренно не считаются.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count((pve_up{id=~\"(qemu|lxc)/.+\", site=~\"$site\"} == 0) and on (instance, id) (pve_onboot_status == 1)) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
