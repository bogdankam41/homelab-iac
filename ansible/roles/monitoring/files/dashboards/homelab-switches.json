{
  "uid": "homelab-switches",
  "title": "Homelab — коммутаторы",
  "tags": [
    "homelab",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "switch",
        "label": "Коммутатор",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=~\"snmp|sks\"}, name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Коммутаторы",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "up{job=~\"snmp|sks\", name=~\"$switch\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "в сети",
                  "color": "green"
                },
                "0": {
                  "text": "нет связи",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "description": "Отвечает ли коммутатор экспортеру (SNMP или веб-API)."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sysUpTime{job=\"snmp\", name=~\"$switch\"} / 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "description": "Только у SNMP-коммутаторов: веб-API SKS3200 uptime не отдаёт."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU, 5 мин",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "switchCpuBusy5m{name=~\"$switch\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "description": "Загрузка CPU коммутатора за 5 минут (vendor MIB). Короткие пики до 90%+ при входе по SSH — норма для RTL8390."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "RAM",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * switchMemoryUsedBytes{name=~\"$switch\"} / switchMemorySizeBytes{name=~\"$switch\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Температура",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sks_temperature_celsius{name=~\"$switch\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "description": "Датчик платы SKS3200. Оранжевый — от 60 °C, красный — от 70 °C (алерт SwitchHighTemperature)."
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Линк портов — SNMP",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "ifOperStatus{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"}",
          "legendFormat": "{{name}} {{ifName}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "up",
                  "color": "green"
                },
                "2": {
                  "text": "down",
                  "color": "transparent"
                },
                "7": {
                  "text": "lowerLayerDown",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "description": "IF-MIB ifOperStatus. Частые переключения поднимают алерт SwitchPortFlapping."
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Линк портов — SKS3200",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sks_port_up{job=\"sks\", name=~\"$switch\"}",
          "legendFormat": "{{name}} порт {{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "up",
                  "color": "green"
                },
                "0": {
                  "text": "down",
                  "color": "transparent"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "description": "Порты 1–8 — 2.5G RJ45 (PoE), 9–10 — 10G SFP+."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "SNMP — входящий трафик",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "8 * rate(ifHCInOctets{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"}[2m]) and on (instance, ifIndex) ifOperStatus{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"} == 1",
          "legendFormat": "{{name}} {{ifName}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Только порты с линком. Port-Channel — сумма своих членов."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "SNMP — исходящий трафик",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "8 * rate(ifHCOutOctets{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"}[2m]) and on (instance, ifIndex) ifOperStatus{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"} == 1",
          "legendFormat": "{{name}} {{ifName}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Только порты с линком. Port-Channel — сумма своих членов."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "SKS3200 — принято пакетов",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(sks_port_rx_packets_total{job=\"sks\", name=~\"$switch\"}[2m]) and on (instance, port) sks_port_up{job=\"sks\", name=~\"$switch\"} == 1",
          "legendFormat": "{{name}} порт {{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Веб-API SKS3200 считает только пакеты, без байтов. Байты по аплинку видны на SNMP-коммутаторе (Port-Channel)."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "SKS3200 — отправлено пакетов",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(sks_port_tx_packets_total{job=\"sks\", name=~\"$switch\"}[2m]) and on (instance, port) sks_port_up{job=\"sks\", name=~\"$switch\"} == 1",
          "legendFormat": "{{name}} порт {{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Веб-API SKS3200 считает только пакеты, без байтов. Байты по аплинку видны на SNMP-коммутаторе (Port-Channel)."
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Скорость линков",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "1e6 * ifHighSpeed{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"} and on (instance, ifIndex) ifOperStatus{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"} == 1",
          "legendFormat": "{{name}} {{ifName}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sks_port_speed_bits{job=\"sks\", name=~\"$switch\"} and on (instance, port) sks_port_up{job=\"sks\", name=~\"$switch\"} == 1",
          "legendFormat": "{{name}} порт {{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "max": 10000000000.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "blue",
                "value": 1000000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "description": "Договорённая скорость. Порт ниже ожидаемой (2.5G-порт на 100M) — повод проверить кабель."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "LAG (LACP) на SKS3200",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 10,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sks_lag_member_active{job=\"sks\", name=~\"$switch\"}",
          "legendFormat": "{{name}} группа {{group}} порт {{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "selected",
                  "color": "green"
                },
                "0": {
                  "text": "standby",
                  "color": "blue"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "description": "Члены агрегата: selected — порт несёт трафик, standby — в резерве. Агрегат задуман как резервирование, не сложение: один selected и один standby — норма. Тревожно, если selected нет ни одного."
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Ошибки за период",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(increase(ifInErrors{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"}[$__range]) + increase(ifOutErrors{job=\"snmp\", name=~\"$switch\", ifName=~\"Ethernet.*|Port-Channel.*\"}[$__range]), \"port\", \"$1\", \"ifName\", \"(.+)\") > 0",
          "legendFormat": "{{name}} {{port}}",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "increase(sks_port_rx_errors_total{job=\"sks\", name=~\"$switch\"}[$__range]) + increase(sks_port_tx_errors_total{job=\"sks\", name=~\"$switch\"}[$__range]) > 0",
          "legendFormat": "{{name}} порт {{port}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "description": "Битые пакеты за выбранный период, только порты с ошибками. Пусто — ошибок нет.",
      "interval": "",
      "maxDataPoints": 1
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "CPU и RAM",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
