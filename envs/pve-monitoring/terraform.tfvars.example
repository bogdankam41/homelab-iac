# Copy to terraform.tfvars and fill in real values. terraform.tfvars is gitignored.
# Node: pve (home) — monitoring VM 192.168.1.40 (Grafana :3000, Prometheus :9090, Alertmanager :9093)

# Proxmox API token: user part in proxmox_user, secret in proxmox_password.
proxmox_user     = "terraform@pve!terraform"
proxmox_password = "REPLACE_WITH_API_TOKEN_SECRET"

# Private key that can log into the cloud-init user on the VM.
ssh_key_path = "~/.ssh/private-key-ed25519"

# Grafana admin credentials.
grafana_admin_user     = "admin"
grafana_admin_password = "REPLACE_WITH_GRAFANA_PASSWORD"

# How long metrics are kept (watch disk_size in main.tf).
prometheus_retention_time = "30d"

# ---------------------------------------------------------------------------
# Devices to monitor. THIS is the list you edit when a new device appears —
# add an entry, run `tofu apply`, done. No .tf file or template is touched.
#
#   name    — label shown in Grafana and in alerts
#   address — host:port of the exporter (node_exporter listens on 9100)
#   job     — optional; defaults to "node" (plain node_exporter hosts)
#   labels  — optional extra labels
#
# A Linux device first needs the exporter installed:
#   ansible-playbook -i '192.168.1.50,' -u ubuntu --private-key ~/.ssh/private-key-ed25519 \
#     -b ../../ansible/node_exporter.yml
# ---------------------------------------------------------------------------
monitoring_targets = [
  # labels: role groups devices by kind, site by location (home / pve-2) —
  # the overview dashboard and alerts use both.
  { name = "pve", address = "192.168.1.10:9100", labels = { role = "hypervisor", site = "home" } },
  # The second node is scraped across the IPSec tunnel — no exporter port has to
  # be exposed to the internet, the tunnel already carries the LAN.
  { name = "pve-2", address = "192.168.2.10:9100", labels = { role = "hypervisor", site = "pve-2" } },

  { name = "k3s-master", address = "192.168.1.30:9100", labels = { role = "k3s", site = "home" } },
  { name = "k3s-worker-1", address = "192.168.1.31:9100", labels = { role = "k3s", site = "home" } },
  { name = "k3s-worker-2", address = "192.168.1.32:9100", labels = { role = "k3s", site = "home" } },

  # AdGuard LXCs and other guests: ansible/node_exporter.yml, as for any host.
  { name = "adguard-home", address = "192.168.1.2:9100", labels = { role = "dns", site = "home" } },
  { name = "adguard-pve-2", address = "192.168.2.2:9100", labels = { role = "dns", site = "pve-2" } },

  # Keenetic routers (Entware): ansible/keenetic_node_exporter.yml. The exporter
  # listens on the LAN IP only.
  { name = "router-home", address = "192.168.1.1:9100", labels = { role = "router", site = "home" } },
  { name = "router-pve2", address = "192.168.2.1:9100", labels = { role = "router", site = "pve-2" } },

  # A device with its own exporter goes into its own job:
  # { name = "adguard", address = "192.168.1.2:9617", job = "adguard" },
]

# ---------------------------------------------------------------------------
# Proxmox nodes, scraped through pve_exporter: the node plus every VM/CT on it
# (status, CPU, RAM, disk, network) without an agent in the guests. The nodes
# are not clustered, so each gets its own read-only token. On every node:
#
#   pveum user add prometheus@pve --comment "pve_exporter (read-only)"
#   pveum acl modify / --users prometheus@pve --roles PVEAuditor
#   pveum user token add prometheus@pve monitoring --privsep 0
#
# The last command prints the secret — it goes into token_secret.
# ---------------------------------------------------------------------------
monitoring_pve_nodes = [
  {
    name         = "pve"
    address      = "192.168.1.10"
    token_id     = "prometheus@pve!monitoring"
    token_secret = "REPLACE_WITH_TOKEN_SECRET"
  },
  {
    name         = "pve-2"
    address      = "192.168.2.10"
    token_id     = "prometheus@pve!monitoring"
    token_secret = "REPLACE_WITH_TOKEN_SECRET"
  },
]

# Dashboards pulled from grafana.com into the "Homelab" folder.
# gnet_id / revision are the numbers from https://grafana.com/grafana/dashboards/<id>.
grafana_dashboards = [
  { name = "node-exporter-full", gnet_id = 1860, revision = 37 },
  { name = "proxmox", gnet_id = 10347, revision = 5 },
  # { name = "prometheus-overview", gnet_id = 3662, revision = 2 },
  # { name = "alertmanager",        gnet_id = 9578, revision = 4 },
]

# Federation: the k3s cluster's Prometheus (kube-prometheus-stack, NodePort 30090)
# keeps ~3 days; this pulls the series the k3s dashboard needs into the local
# Prometheus (30 days). The match[] set lives in the role (monitoring_federation_match).
monitoring_federation = [
  { job = "k3s-federate", address = "192.168.1.30:30090", labels = { cluster = "k3s" } },
]

# Extra Prometheus datasources. "k3s" is the cluster's own Prometheus
# (kube-prometheus-stack, NodePort 30090) — the "k3s — обзор" dashboard reads it.
grafana_extra_datasources = [
  { name = "k3s", uid = "k3s", url = "http://192.168.1.30:30090" },
]

# Alerting. Leave the Telegram fields empty to keep alerts in the UI only.
alerts_enabled     = true
telegram_bot_token = ""
telegram_chat_id   = ""

# Optional threshold overrides (defaults: 90% CPU/RAM, 85% disk).
# alert_thresholds = {
#   alert_disk_threshold = "90"
#   alert_cpu_for        = "15m"
# }
